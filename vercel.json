{
  "outputDirectory": "dist",
  "redirects": [
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "www.triptic.my"
        }
      ],
      "destination": "https://triptic.my/$1",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    },
    {
      "source": "/sitemap.xml",
      "destination": "/api/seo?route=sitemap"
    },
    {
      "source": "/flights",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*(Yeti|Googlebot|bingbot|Daumoa|DaumApps|kakaotalk-scrap|facebookexternalhit|Twitterbot|Slackbot|Discordbot|TelegramBot|LinkedInBot).*"
        }
      ],
      "destination": "/api/seo?route=page&path=/flights"
    },
    {
      "source": "/hotels",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*(Yeti|Googlebot|bingbot|Daumoa|DaumApps|kakaotalk-scrap|facebookexternalhit|Twitterbot|Slackbot|Discordbot|TelegramBot|LinkedInBot).*"
        }
      ],
      "destination": "/api/seo?route=page&path=/hotels"
    },
    {
      "source": "/activities",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*(Yeti|Googlebot|bingbot|Daumoa|DaumApps|kakaotalk-scrap|facebookexternalhit|Twitterbot|Slackbot|Discordbot|TelegramBot|LinkedInBot).*"
        }
      ],
      "destination": "/api/seo?route=page&path=/activities"
    },
    {
      "source": "/community",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*(Yeti|Googlebot|bingbot|Daumoa|DaumApps|kakaotalk-scrap|facebookexternalhit|Twitterbot|Slackbot|Discordbot|TelegramBot|LinkedInBot).*"
        }
      ],
      "destination": "/api/seo?route=page&path=/community"
    },
    {
      "source": "/community/d/:slug",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*(Yeti|Googlebot|bingbot|Daumoa|DaumApps|kakaotalk-scrap|facebookexternalhit|Twitterbot|Slackbot|Discordbot|TelegramBot|LinkedInBot).*"
        }
      ],
      "destination": "/api/seo?route=dest&slug=:slug"
    },
    {
      "source": "/community/post/:id",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*(Yeti|Googlebot|bingbot|Daumoa|DaumApps|kakaotalk-scrap|facebookexternalhit|Twitterbot|Slackbot|Discordbot|TelegramBot|LinkedInBot).*"
        }
      ],
      "destination": "/api/seo?route=post&id=:id"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "geolocation=(self), camera=(), microphone=()"
        },
        {
          "key": "Content-Security-Policy-Report-Only",
          "value": "default-src 'self'; script-src 'self' 'unsafe-inline' https://cdn.jsdelivr.net https://cdnjs.cloudflare.com https://maps.googleapis.com https://tp-em.com https://tpembd.com https://cdn.klook.com; style-src 'self' 'unsafe-inline' https://cdn.jsdelivr.net; font-src 'self' https://cdn.jsdelivr.net data:; img-src 'self' data: https:; connect-src 'self' https://api.open-meteo.com https://*.supabase.co https://maps.googleapis.com https://maps.gstatic.com https://us.i.posthog.com https://us-assets.i.posthog.com https://*.ingest.sentry.io https://*.ingest.us.sentry.io; frame-src 'self' https://affiliate.klook.com https://*.trip.com; frame-ancestors 'self'"
        }
      ]
    }
  ],
  "functions": {
    "api/recommend.js": {
      "maxDuration": 30
    },
    "api/cityDesc.js": {
      "maxDuration": 20
    },
    "api/adminSales.js": {
      "maxDuration": 30
    },
    "api/parseDocument.js": {
      "maxDuration": 60,
      "includeFiles": "{data/airports.json,node_modules/unpdf/dist/**}"
    }
  }
}
