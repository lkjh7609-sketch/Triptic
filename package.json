{
  "name": "triptic",
  "version": "3.0.0-dev",
  "description": "Smart Travel Planner — document-to-itinerary, map-based routes, community",
  "type": "module",
  "scripts": {
    "dev": "node scripts/build.js && vite",
    "build": "node scripts/build.js && tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "check:i18n": "node scripts/check-i18n.js",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"src/**/*.{js,ts,tsx,json,css,md}\"",
    "format:check": "prettier --check \"src/**/*.{js,ts,tsx,json,css,md}\"",
    "analyze": "vite-bundle-visualizer",
    "clean": "rm -rf dist coverage node_modules/.vite"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.2",
    "@eslint/js": "^9.0.0",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.0.0",
    "@testing-library/user-event": "^14.0.0",
    "@types/google.maps": "^3.66.0",
    "@types/node": "^20.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "@vitest/coverage-v8": "^3.2.0",
    "eslint": "^9.0.0",
    "eslint-plugin-react-hooks": "^7.0.0",
    "eslint-plugin-react-refresh": "^0.5.0",
    "globals": "^15.0.0",
    "jsdom": "^30.0.0",
    "prettier": "^3.0.0",
    "terser": "^5.24.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.0.0",
    "tz-lookup": "^6.1.25",
    "vite": "^7.0.0",
    "vite-bundle-visualizer": "^1.0.0",
    "vitest": "^3.2.0"
  },
  "dependencies": {
    "@capacitor/core": "^8.5.2",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/ios": "^8.5.2",
    "@capacitor/status-bar": "^8.0.3",
    "@dnd-kit/core": "^6.0.0",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.0.0",
    "@googlemaps/js-api-loader": "^2.0.0",
    "@hookform/resolvers": "^5.0.0",
    "@sentry/react": "^10.0.0",
    "@supabase/supabase-js": "^2.38.0",
    "@tanstack/react-query": "^5.0.0",
    "date-fns": "^4.0.0",
    "date-fns-tz": "^3.0.0",
    "i18next": "^25.0.0",
    "i18next-browser-languagedetector": "^8.0.0",
    "jose": "^6.0.0",
    "jspdf": "^2.5.1",
    "motion": "^12.0.0",
    "posthog-js": "^1.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-hook-form": "^7.0.0",
    "react-i18next": "^16.0.0",
    "react-router": "^7.0.0",
    "react-svg-worldmap": "^2.0.2",
    "zod": "^4.0.0",
    "zustand": "^5.0.0"
  },
  "engines": {
    "node": ">=22.0.0",
    "npm": ">=10.0.0"
  }
}
